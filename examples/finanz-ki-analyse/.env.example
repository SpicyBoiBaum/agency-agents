# Pflicht für die KI-Analyse: API-Schlüssel von https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Pflicht, sobald die App im Netzwerk/Internet erreichbar ist (HOST=0.0.0.0)
# APP_PASSWORD=ein-langes-sicheres-passwort

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# ANALYSIS_EFFORT=high          # low | medium | high | xhigh | max
# MAX_WEB_SEARCHES=8            # Websuchen pro Analyse
# COINGECKO_API_KEY=            # kostenloser Demo-Key erhöht das Rate-Limit
# PORT=3000
# HOST=127.0.0.1                # 0.0.0.0 = im Netzwerk erreichbar (dann APP_PASSWORD setzen)
# DATA_DIR=./data               # hier liegen Alarme, Push-Abos und Schlüssel
# ALERT_CHECK_INTERVAL=60       # Sekunden zwischen den Alarm-Prüfungen
# SESSION_SECRET=               # optional fest vorgeben, sonst automatisch erzeugt
# TRUST_PROXY=1                 # hinter einem Hosting-Proxy (Railway, Render …)

# Push-Benachrichtigungen: Schlüssel werden automatisch erzeugt und in DATA_DIR
# gespeichert. Bei Hosting ohne dauerhaften Speicher hier fest eintragen
# (erzeugen mit: npm run vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:deine@email.de
